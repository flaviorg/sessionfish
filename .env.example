# No key at all: sessionfish uses the scripted fake model (offline, demo session only).
# The code-only review (replay, eval bar, ??/?/?! annotations) never needs a model:
#   sessionfish review session.jsonl --no-analysis

# Anthropic (default analysis model: anthropic:claude-sonnet-5-5)
ANTHROPIC_API_KEY=

# Any LangChain "provider:model" id. --model wins over SESSIONFISH_MODEL.
# SESSIONFISH_MODEL=anthropic:claude-sonnet-5-5
# SESSIONFISH_MODEL=openai:gpt-5.1

# OpenAI or any OpenAI-compatible endpoint
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.example.com/v1

# OpenRouter: SESSIONFISH_MODEL=openrouter:<vendor>/<model>
# OPENROUTER_API_KEY=
